{% macro codepen(slugHash,defaultTabs,penTitle,preview) %}
<p
  data-height="384"
  data-theme-id="dark"
  data-slug-hash="{{ slugHash }}"
  data-default-tab="{{ defaultTabs }}"
  data-user="bobbyshowalter"
  data-embed-version="2"
  data-pen-title="{{ penTitle }}"
  data-preview="{{ preview }}"
  class="codepen">
    See the Pen
    <a href="https://codepen.io/bobbyshowalter/pen/{{ slugHash }}/">
      {{ penTitle }}
    </a>
    by Bobby Showalter
    (<a href="https://codepen.io/bobbyshowalter">@bobbyshowalter</a>)
    on
    <a href="https://codepen.io">CodePen</a>.
</p>
<script async src="https://static.codepen.io/assets/embed/ei.js"></script>
{% endmacro %}
