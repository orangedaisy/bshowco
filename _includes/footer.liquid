<footer class="site-footer">

  <div class="has-flow">
    <p>&copy; 2017&ndash;<span id="footerCurrentYear">{{ 'now' | date: '%Y' }}</span> Bobby Showalter</p>
    <p><strong>{{ site.description | escape }}</strong></p>
  </div>

  <div class="site-footer__icons">
    {% include 'icon-link' icon='codepen' domain='.io' username=site.codepen_username %}
    {% include 'icon-link' icon='github' username=site.github_username %}
    {% include 'icon-link' icon='instagram' username=site.instagram_username %}
    <a class="c-icon__link" href="{{ "/feed.xml" | url }}">
      <svg class="c-icon c-icon--rss">
        <use xlink:href="/symbol-defs.svg#c-icon--rss"></use>
      </svg>
    </a>
  </div>

  <script>
    document.getElementById('footerCurrentYear').textContent = new Date().getFullYear();
  </script>

</footer>
