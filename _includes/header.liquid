<header class="site-header" role="banner">

  <h1>{{ site.title | escape }}</h1>

  <nav>
    <ul role="list">
      <li>
        <a href="{{ '/' | url }}"{% if page.url == '/' %} aria-current='page'{% endif %}>Home</a>
      </li>
      <li>
        <a href="{{ '/blog/' | url }}"{% if page.fileSlug == 'blog' %} aria-current='page'{% endif %}>Blog</a>
      </li>
      <li>
        <a href="{{ '/portfolio/' | url }}"{% if page.fileSlug == 'portfolio' %} aria-current='page'{% endif %}>Work</a>
      </li>
      <li>
        <a href="{{ '/uses/' | url }}"{% if page.fileSlug == 'uses' %} aria-current='page'{% endif %}>Slash</a>
      </li>
    </ul>
  </nav>

</header>
